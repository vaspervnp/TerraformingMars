<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.2</Version>
    <RootNamespace>TerraformingMars.Setup</RootNamespace>
    <AssemblyName>TerraformingMars.Setup</AssemblyName>
    <!-- Δεν είναι μέρος του παιχνιδιού: φτιάχνει τους installers από τα published binaries. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Τα scripts εγκατάστασης ταξιδεύουν μέσα στο ίδιο το εργαλείο. -->
    <EmbeddedResource Include="Templates\**\*" />
    <!-- Το εικονίδιο του παιχνιδιού: .ico για τα Windows, το 256px PNG του για το Linux. -->
    <EmbeddedResource Include="..\TerraformingMars.Game\Icon.ico" LogicalName="Icon.ico" />
  </ItemGroup>

</Project>
